      next.push({ name, slots: teams[i] ? teams[i].slots : [null, null, null, null] });
    }
    teams.slice(teamCount).forEach(t => t.slots.forEach(s => s && URL.revokeObjectURL(s.url)));
    teams = next;
    if (current >= teams.length) current = 0;
    if (!song) pickSong();
