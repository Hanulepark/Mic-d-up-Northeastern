    stopAllAudio();
    document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.id === id));
    window.scrollTo(0, 0);
  }
  document.querySelectorAll("[data-go]").forEach(b => b.addEventListener("click", () => {
    if (recSlot !== -1) { stopRecording(); showErr(""); }
