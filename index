  const KEY = "micdup-songs";
  let custom = [], mode = "all";
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || "null");
    if (saved && Array.isArray(saved.songs)) custom = saved.songs.filter(x => Array.isArray(x) && x[0]).map(x => [String(x[0]).slice(0, 80), String(x[1] || "").slice(0, 60)]);
    if (saved && saved.mode === "mine" && custom.length) mode = "mine";
  } catch (e) {}
  function saveList() { try { localStorage.setItem(KEY, JSON.stringify({ songs: custom, mode })); } catch (e) {} }
  let deck = [];
  var song = null;
  function shuffle(a) {
    for (let i = a.length - 1; i > 0; i--) { const k = Math.floor(Math.random() * (i + 1)); [a[i], a[k]] = [a[k], a[i]]; }
    return a;
  }
  function pool() { return (mode === "mine" && custom.length) ? custom : SONGS.concat(custom); }
  function pickSong() {
    if (!deck.length) deck = shuffle(pool().slice()).filter(s => s !== song);
    if (!deck.length) deck = pool().slice();
    song = deck.pop();
    $("songTitle").textContent = song[0];
    $("songArtist").textContent = song[1] || "";
    $("spotify").href = "https://open.spotify.com/search/" + encodeURIComponent((song[0] + " " + (song[1] || "")).trim());
    $("now").textContent = song[1] ? song[0] + " by " + song[1] : song[0];
    resetClip();
  }

