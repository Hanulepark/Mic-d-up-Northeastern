    const box = $("names");
    box.innerHTML = "";
    for (let i = 0; i < teamCount; i++) {
      const inp = document.createElement("input");
      inp.value = names[i];
      inp.setAttribute("aria-label", "Team " + (i + 1) + " name");
      inp.maxLength = 24;
      inp.addEventListener("input", () => { names[i] = inp.value; });
      box.appendChild(inp);
