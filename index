  /* ---------- 10-second clip ---------- */
  var clip = null, clipTimer = null, clipCache = {}, clipReq = 0, clipNoteId = "clipNote";
  function clipKey(s) { return s[0] + "|" + (s[1] || ""); }
  function setClipNote(text, link) {
    const n = $(clipNoteId);
    n.textContent = text || "";
    if (link && /^https:\/\//.test(link)) {
      const a = document.createElement("a");
      a.href = link; a.target = "_blank"; a.rel = "noopener"; a.textContent = "Apple Music";
      n.append(" ", a);
    }
  }
  function stopClip() {
    if (clip) { clip.pause(); clip = null; }
    clearInterval(clipTimer); clipTimer = null;
    document.querySelectorAll(".clipbtn").forEach(b => b.textContent = "Play 10 seconds");
  }
  function resetClip() {
    clipReq++; stopClip();
    ["clipNote", "clipNote2"].forEach(id => { const n = $(id); if (n) n.textContent = ""; });
    if (song) findPreview(song).catch(() => {});   // load ahead so the tap plays right away
  }
  function findPreview(s) {
    return new Promise((resolve, reject) => {
      const k = clipKey(s);
      if (clipCache[k]) return resolve(clipCache[k]);
      const cb = "micdupClip" + Date.now() + Math.floor(Math.random() * 1e6);
      const sc = document.createElement("script");
      let t;
      const done = (v, err) => { delete window[cb]; sc.remove(); clearTimeout(t); err ? reject(err) : resolve(v); };
      t = setTimeout(() => done(null, new Error("network")), 8000);
      window[cb] = data => {
        const r = ((data && data.results) || []).find(x => x && x.previewUrl && /^https:\/\//.test(x.previewUrl));
        if (!r) return done(null, new Error("none"));
        const v = { url: r.previewUrl, link: r.trackViewUrl };
        clipCache[k] = v; done(v);
      };
      sc.onerror = () => done(null, new Error("network"));
      sc.src = "https://itunes.apple.com/search?media=music&entity=song&limit=5&country=US&term=" +
        encodeURIComponent((s[0] + " " + (s[1] || "")).trim()) + "&callback=" + cb;
      document.head.appendChild(sc);
    });
  }
  async function playClip(b, noteId) {
    if (clip) { stopClip(); return; }
    ["clipNote", "clipNote2"].forEach(id => { const n = $(id); if (n) n.textContent = ""; });
    clipNoteId = noteId;
    const req = ++clipReq, s = song;
    b.textContent = "Loading…"; setClipNote("");
    let p;
    try { p = await findPreview(s); }
    catch (e) {
      if (req !== clipReq) return;
      b.textContent = "Play 10 seconds";
      setClipNote(e.message === "none"
        ? "No clip found for this song. Use Open in Spotify to hear it."
        : "Couldn’t load a clip. Clips need an internet connection and only work on your own hosted site.");
      return;
    }
    if (req !== clipReq) return;
    clip = new Audio(p.url);
    let left = 10;
    b.textContent = "Stop";
    setClipNote("Clip from", p.link);
    clip.addEventListener("playing", () => {
      if (clipTimer) return;
      b.textContent = "Stop (" + left + ")";
      clipTimer = setInterval(() => {
        left--;
        if (left <= 0) stopClip(); else b.textContent = "Stop (" + left + ")";
      }, 1000);
    });
    clip.onended = stopClip;
    clip.play().catch(() => { stopClip(); setClipNote("Tap Play 10 seconds again to start the clip."); });
  }
  $("clipBtn").addEventListener("click", e => playClip(e.currentTarget, "clipNote"));
