    countTimer = setInterval(() => {
      n--;
      if (n > 0) setStatus(j, "Starting in " + n);
      else { clearInterval(countTimer); countTimer = null; beginTake(j); }
    }, 1000);
  }

  function beginTake(j) {
    chunks = [];
    recorder = new MediaRecorder(stream);
    recorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
    const team = teams[current];
    recorder.onstop = () => {
      if (bgAudio) { bgAudio.pause(); bgAudio = null; }
      if (!discard) {
        const blob = new Blob(chunks, { type: recorder.mimeType || "audio/webm" });
        if (team.slots[j]) URL.revokeObjectURL(team.slots[j].url);
        team.slots[j] = { url: URL.createObjectURL(blob), secs: Math.min(REC_SECS, (Date.now() - recStart) / 1000) };
      }
      recSlot = -1; recPhase = null;
      renderStudio();
    };
    recPhase = "rec";
    recorder.start();
    if (bgAudio) { bgAudio.currentTime = 0; bgAudio.muted = false; bgAudio.play().catch(() => {}); }
    recStart = Date.now();
    renderStudio();
    startMeter();
    const tick = () => {
      const left = Math.max(1, Math.ceil(REC_SECS - (Date.now() - recStart) / 1000));
      setStatus(j, left + (left === 1 ? " second" : " seconds") + " left");
    };
    tick();
    timer = setInterval(() => {
      if (Date.now() - recStart >= REC_SECS * 1000) finishRecording(); else tick();
    }, 100);
  }

  function finishRecording() {
    clearInterval(timer); timer = null; cancelAnimationFrame(raf);
    if (recorder && recorder.state === "recording") recorder.stop();
  }

  // Tapping during the count-in or the recording cancels it; partial takes are not kept.
  function stopRecording() {
    if (recSlot === -1) return;
    const counting = recPhase === "count";
    clearInterval(countTimer); countTimer = null;
    discard = true;
    if (bgAudio) { bgAudio.pause(); bgAudio = null; }
    if (counting) { recSlot = -1; recPhase = null; renderStudio(); }
    else finishRecording();
    showErr("Recording canceled. Each layer needs the full 10 seconds, so keep going until it stops on its own.");
  }

  function startMeter() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioCtx.createAnalyser(); analyser.fftSize = 256;
        audioCtx.createMediaStreamSource(stream).connect(analyser);
      }
      if (audioCtx.state === "suspended") audioCtx.resume();
    } catch (e) { return; }
    const data = new Uint8Array(analyser.fftSize);
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tick = () => {
      analyser.getByteTimeDomainData(data);
      let peak = 0;
      for (let i = 0; i < data.length; i++) peak = Math.max(peak, Math.abs(data[i] - 128));
      const ring = document.querySelector(".rec.on .ring");
      if (ring && !reduce) ring.style.transform = "scale(" + (1 + Math.min(peak / 128, 1) * 0.6) + ")";
      raf = requestAnimationFrame(tick);
    };
    tick();
  }

  /* ---------- Playback ---------- */
  function stopAllAudio() {
    stopClip();
    playing.forEach(a => { a.pause(); a.currentTime = 0; });
    playing = [];
    document.querySelectorAll(".play").forEach(b => b.textContent = "Play");
    if ($("playAll")) $("playAll").textContent = "Play all layers";
  }

  function togglePlay(indexes, btn) {
    const wasPlaying = btn.dataset.on === "1";
    stopAllAudio();
    document.querySelectorAll("[data-on]").forEach(b => b.dataset.on = "");
    if (wasPlaying) return;
    const slots = teams[current].slots;
    const list = indexes.map(i => slots[i]).filter(Boolean);
    if (!list.length) return;
    let left = list.length;
    btn.dataset.on = "1";
    btn.textContent = "Stop";
    playing = list.map(s => {
      const a = new Audio(s.url);
      a.onended = () => { if (--left === 0) { btn.dataset.on = ""; stopAllAudio(); } };
      return a;
    });
    playing.forEach(a => a.play().catch(() => {}));
  }

  $("playAll").addEventListener("click", e => togglePlay([0, 1, 2, 3], e.currentTarget));
})();
</script>
</body>
</html>
