<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mic’d Up</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,500;12..96,800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #000000;
    --fg: #ffffff;
    --dim: #8c8c8c;
    --line: #ffffff;
    --font: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
    --pad: clamp(1.25rem, 4vw, 3rem);
    color-scheme: dark;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg:#000; --fg:#fff; --dim:#8c8c8c; } }
  :root[data-theme="dark"] { --bg:#000; --fg:#fff; --dim:#8c8c8c; }
  *, *::before, *::after { box-sizing: inherit; }
  html { height: 100%; scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0; height: 100%;
    background: var(--bg); color: var(--fg);
    font-family: var(--font); font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  button, input { font: inherit; color: inherit; }
  button, a.btn {
    background: transparent; border: 1px solid var(--line); border-radius: 999px;
    padding: .8rem 1.8rem; cursor: pointer; font-weight: 500;
    font-size: clamp(1rem, 1.4vw, 1.15rem); color: var(--fg); text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
  }
  button:hover, a.btn:hover { background: var(--fg); color: var(--bg); }
  button:disabled { opacity: .3; cursor: default; }
  button:disabled:hover { background: transparent; color: var(--fg); }
  :focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  .page { display: none; min-height: 100%; padding: var(--pad); }
  .page.active { display: flex; flex-direction: column; }
  .wrap { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 90rem; margin: 0 auto; }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .back, .bar .small {
    border: none; padding: .4rem 0; color: var(--dim); font-weight: 300; align-self: flex-start;
  }
  .back:hover, .bar .small:hover { background: none; color: var(--fg); }
  h2 {
    font-weight: 500; font-size: clamp(2.2rem, 6vw, 5rem); letter-spacing: -.03em; line-height: 1;
    margin: auto 0 clamp(1.5rem, 5vh, 3.5rem);
  }
  #rules h2, #list h2 { margin-top: clamp(1.5rem, 6vh, 4rem); }
  .push { margin-top: auto; width: 100%; padding: 1.15rem; font-size: clamp(1.05rem, 1.8vw, 1.3rem); }

  /* Title */
  #title { align-items: center; justify-content: center; text-align: center; gap: clamp(1.5rem, 5vh, 3.5rem); }
  .logo {
    font-weight: 800; font-size: min(30vw, 34vh); line-height: .82; letter-spacing: -.05em; margin: 0;
    color: transparent; -webkit-text-stroke: max(1.5px, .14vw) var(--fg);
  }
  .logo span { display: block; }
  .tag { margin: 0; color: var(--dim); font-size: clamp(1.1rem, 2.4vw, 1.75rem); }
  #startBtn { width: min(100%, 22rem); padding: 1.15rem 2rem; font-size: clamp(1.05rem, 1.8vw, 1.3rem); }

  /* Teams */
  .stepper { display: flex; align-items: center; gap: clamp(1rem, 4vw, 3rem); margin-bottom: clamp(1.5rem, 6vh, 3.5rem); }
  .stepper button { width: clamp(3rem, 7vw, 4.5rem); height: clamp(3rem, 7vw, 4.5rem); padding: 0; font-size: 1.6rem; line-height: 1; }
  .count { font-size: clamp(4.5rem, 15vw, 10rem); font-weight: 800; line-height: .9; min-width: 2ch; text-align: center; font-variant-numeric: tabular-nums; }
  .names { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem 2.5rem; margin-bottom: 2.5rem; }
  .names input, .addrow input {
    min-width: 0; background: transparent; border: none; border-bottom: 1px solid var(--line);
    border-radius: 0; padding: .6rem 0; font-size: clamp(1.2rem, 2.4vw, 1.8rem);
  }
  .names input:focus-visible, .addrow input:focus-visible { outline: none; border-bottom-width: 2px; }
  .addrow input::placeholder { color: var(--dim); }

  /* Rules */
  .rules ol, .rules ul { max-width: 62ch; margin: 0 0 2.5rem; padding-left: 1.6rem; line-height: 1.55; font-size: clamp(1.05rem, 1.7vw, 1.35rem); }
  .rules li { margin-bottom: .9rem; padding-left: .3rem; }
  .rules ol li::marker { font-weight: 800; }
  .rules ul li::marker { color: var(--dim); }
  .rules h3 { font-weight: 500; font-size: clamp(1.3rem, 2.4vw, 1.9rem); margin: 0 0 1rem; }

  /* Song */
  .songcard { margin-bottom: clamp(1.5rem, 5vh, 3rem); }
  .stitle { font-weight: 800; font-size: clamp(2.6rem, 9vw, 8rem); line-height: .92; letter-spacing: -.04em; overflow-wrap: break-word; }
  .sartist { color: var(--dim); margin-top: .8rem; font-size: clamp(1.15rem, 2.6vw, 2rem); }
  .clipnote { color: var(--dim); font-size: clamp(.9rem, 1.3vw, 1.05rem); margin-top: 1.25rem; }
  .clipnote:empty { display: none; }
  .clipnote a { color: var(--fg); }
  .songrow { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 2rem; }

  /* Your songs */
  .addrow { display: grid; grid-template-columns: 2fr 1.5fr auto; gap: 1rem 1.5rem; align-items: end; margin-bottom: 2rem; }
  .seg { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .seg button { padding: .55rem 1.2rem; font-weight: 300; border-color: var(--dim); color: var(--dim); }
  .seg button[aria-checked="true"] { border-color: var(--fg); color: var(--fg); font-weight: 500; }
  .seg button:hover { background: none; color: var(--fg); border-color: var(--fg); }
  .mylist { list-style: none; margin: 0; padding: 0; }
  .mylist li {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .85rem 0; border-bottom: 1px solid var(--dim); font-size: clamp(1rem, 1.6vw, 1.25rem);
  }
  .mylist li.empty { color: var(--dim); border-bottom: none; }
  .mylist .rm { padding: .35rem .9rem; font-size: .85rem; font-weight: 300; flex-shrink: 0; }

  /* Studio */
  .nowrow { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1.25rem; margin: clamp(1rem, 3vh, 2rem) 0 1rem; }
  .now { margin: 0; color: var(--dim); font-size: clamp(1rem, 1.8vw, 1.35rem); }
  .nowrow .clipbtn { padding: .55rem 1.3rem; font-size: clamp(.95rem, 1.3vw, 1.05rem); }
  .studionote { margin: -.25rem 0 1rem; }
  .recopts { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1.25rem; margin-bottom: .5rem; }
  .hint { margin: 0; font-size: clamp(.95rem, 1.5vw, 1.15rem); max-width: 60ch; line-height: 1.4; }
  .hint.dimmer { color: var(--dim); font-size: clamp(.85rem, 1.3vw, 1rem); margin: 0 0 1rem; }
  .hint.dimmer:empty { display: none; }
  .toggle { padding: .5rem 1.2rem; font-weight: 300; font-size: clamp(.9rem, 1.3vw, 1rem); }
  .toggle[aria-pressed="false"] { border-color: var(--dim); color: var(--dim); }
  .tabs { display: flex; gap: .5rem; overflow-x: auto; padding: 3px; margin: 0 -3px 1.25rem; }
  .tabs button { white-space: nowrap; padding: .5rem 1.2rem; font-weight: 300; border-color: var(--dim); color: var(--dim); }
  .tabs button[aria-selected="true"] { border-color: var(--fg); color: var(--fg); font-weight: 500; }
  .tabs button:hover { background: none; color: var(--fg); border-color: var(--fg); }
  .err { border: 1px dashed var(--fg); border-radius: 1rem; padding: .8rem 1rem; margin-bottom: 1.25rem; display: none; }
  .grid {
    flex: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(12rem, 1fr);
    gap: clamp(.75rem, 1.5vw, 1.25rem); margin-bottom: 1.25rem;
  }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .slot {
    border: 1px solid var(--line); border-radius: 1.5rem; padding: clamp(1rem, 2vw, 1.5rem);
    display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .slot h3 { margin: 0; font-weight: 500; font-size: clamp(1.05rem, 2vw, 1.5rem); align-self: flex-start; }
  .rec { position: relative; width: clamp(5rem, 12vw, 8.5rem); height: auto; aspect-ratio: 1; border-radius: 50%; padding: 0; display: grid; place-items: center; }
  .rec .dot { width: clamp(1.3rem, 3.2vw, 2.2rem); height: clamp(1.3rem, 3.2vw, 2.2rem); border-radius: 50%; border: 1.5px solid currentColor; }
  .rec.on .dot { border-radius: 12%; background: currentColor; }
  .rec .ring { position: absolute; inset: -1px; border-radius: 50%; border: 1px solid var(--fg); transform: scale(1); pointer-events: none; opacity: 0; }
  .rec.on .ring { opacity: 1; }
  .status { text-align: center; color: var(--dim); font-size: clamp(.9rem, 1.3vw, 1.05rem); min-height: 1.2em; font-variant-numeric: tabular-nums; }
  .slot .row { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: center; }
  .slot .row button { padding: .45rem .95rem; font-size: .9rem; font-weight: 300; }
  .mix { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  #playAll { padding: 1.15rem 2.2rem; font-size: clamp(1.05rem, 1.8vw, 1.3rem); }
  .note, .mix .note { color: var(--dim); font-size: clamp(.9rem, 1.3vw, 1.05rem); margin: 0; }

  @media (max-width: 640px) { .addrow { grid-template-columns: 1fr; } .addrow button { justify-self: start; } }
  @media (max-width: 640px) { .grid { grid-auto-rows: minmax(10rem, 1fr); } .slot .row button { padding: .4rem .8rem; } }
  @media (max-width: 360px) { .grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .rec .ring { transition: none; } }
</style>
</head>
<body>

<!-- Title -->
<section class="page active" id="title" aria-label="Title">
  <h1 class="logo"><span>Mic’d</span><span>Up</span></h1>
  <p class="tag">You are the instrument</p>
  <button id="startBtn">Start</button>
</section>

<!-- Teams -->
<section class="page" id="teams" aria-label="Pick teams">
  <div class="wrap">
    <div class="bar">
      <button class="back" data-go="title">Back</button>
      <button class="small" data-go="rules">Rules</button>
    </div>
    <h2>How many teams?</h2>
    <div class="stepper">
      <button id="minus" aria-label="Fewer teams">−</button>
      <div class="count" id="count" aria-live="polite">2</div>
      <button id="plus" aria-label="More teams">+</button>
    </div>
    <div class="names" id="names"></div>
    <button class="push" id="toStudio">Pick a song</button>
  </div>
</section>

<!-- Rules -->
<section class="page" id="rules" aria-label="Rules">
  <div class="wrap rules">
    <button class="back" data-go="teams">Back to teams</button>
    <h2>Rules</h2>
    <ol>
      <li>Play with at least 3 people. Before the game starts, split into two or more teams and choose one or more judges.</li>
      <li>The app or the judge picks a random song and plays it for the teams to recreate. A Spotify playlist on shuffle works too.</li>
      <li>Each team goes into a separate room to record.</li>
      <li>More people means more a cappella and a fuller, more complex version of the song. Teams of more than one should divide up the parts (beat, bass, singing and so on) or work together on vocal chords and more complex drum parts.</li>
      <li>Each team records each layer of the song, or just sings a section of it, until the song is complete or the time limit runs out.</li>
      <li>The judge chooses which team replicated the song better or made the more interesting cover.</li>
    </ol>
    <h3>Alternate rules</h3>
    <ul>
      <li>Spotify or the teams pick a random song, and teams recreate it with the goal of getting the judge to recognize it.</li>
      <li>Play as one team trying to get the judge to recognize the song. This removes the competition and puts the focus on working together.</li>
    </ul>
  </div>
</section>

<!-- Song -->
<section class="page" id="song" aria-label="Pick a song">
  <div class="wrap">
    <button class="back" data-go="teams">Back to teams</button>
    <h2>Your song</h2>
    <div class="songcard" aria-live="polite">
      <div class="stitle" id="songTitle"></div>
      <div class="sartist" id="songArtist"></div>
      <div class="clipnote" id="clipNote" aria-live="polite"></div>
    </div>
    <div class="songrow">
      <button id="clipBtn" class="clipbtn">Play 10 seconds</button>
      <button id="reroll">Pick another</button>
      <a class="btn" id="spotify" href="https://open.spotify.com" target="_blank" rel="noopener">Open in Spotify</a>
      <button id="openList">Add songs</button>
    </div>
    <button class="push" id="toRecord">Start recording</button>
  </div>
</section>

<!-- Your songs -->
<section class="page" id="list" aria-label="Your songs">
  <div class="wrap">
    <button class="back" id="listBack">Back to song</button>
    <h2>Your songs</h2>
    <div class="addrow">
      <input id="addTitle" placeholder="Song title" aria-label="Song title" maxlength="80">
      <input id="addArtist" placeholder="Artist (optional)" aria-label="Artist" maxlength="60">
      <button id="addBtn">Add song</button>
    </div>
    <div class="seg" role="radiogroup" aria-label="Pick songs from">
      <button role="radio" id="modeAll" aria-checked="true">All songs</button>
      <button role="radio" id="modeMine" aria-checked="false">My songs only</button>
    </div>
    <ul class="mylist" id="mylist"></ul>
  </div>
</section>

<!-- Studio -->
<section class="page" id="studio" aria-label="Record layers">
  <div class="wrap">
    <div class="bar">
      <button class="back" data-go="teams">Teams</button>
      <button class="small" data-go="song">Change song</button>
    </div>
    <div class="nowrow">
      <p class="now" id="now"></p>
      <button id="clipBtn2" class="clipbtn">Play 10 seconds</button>
    </div>
    <div class="clipnote studionote" id="clipNote2" aria-live="polite"></div>
    <div class="recopts">
      <p class="hint">Each layer records for exactly 10 seconds after a 3-second count-in. Keep going until it stops on its own.</p>
      <button id="bgToggle" class="toggle" aria-pressed="true">Clip while recording: On</button>
    </div>
    <p class="hint dimmer" id="bgHint">Wear headphones so the clip doesn’t end up in your recording.</p>
    <div class="tabs" id="tabs" role="tablist"></div>
    <div class="err" id="err" role="alert"></div>
    <div class="grid" id="grid"></div>
    <div class="mix">
      <button id="playAll">Play all layers</button>
      <span class="note" id="mixNote">Record a layer to play the mix</span>
    </div>
  </div>
</section>

<script>
