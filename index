  /* ---------- Studio ---------- */
  function fmt(s) { s = Math.max(0, Math.round(s)); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }

  function renderStudio() {
    const tabs = $("tabs");
    tabs.innerHTML = "";
    teams.forEach((t, i) => {
      const b = document.createElement("button");
      b.textContent = t.name;
      b.setAttribute("role", "tab");
      b.setAttribute("aria-selected", i === current ? "true" : "false");
      b.addEventListener("click", () => {
        if (recSlot !== -1) return;
        stopAllAudio(); current = i; renderStudio();
      });
      tabs.appendChild(b);
    });

    const grid = $("grid");
    grid.innerHTML = "";
    const slots = teams[current].slots;
    LAYERS.forEach((layer, j) => {
      const s = slots[j];
      const el = document.createElement("div");
      el.className = "slot";
      const isRec = recSlot === j;
      el.innerHTML =
        '<h3>' + layer + '</h3>' +
        '<button class="rec' + (isRec ? ' on' : '') + '" aria-label="' + (isRec ? 'Cancel recording ' : 'Record ') + layer + '"><span class="ring"></span><span class="dot"></span></button>' +
        '<div class="status">' + (isRec ? (recPhase === 'rec' ? 'Recording' : 'Get ready') : s ? fmt(s.secs) : 'Empty') + '</div>' +
        '<div class="row">' +
          '<button class="play"' + (s ? '' : ' disabled') + '>Play</button>' +
          '<button class="clear"' + (s ? '' : ' disabled') + '>Clear</button>' +
        '</div>';
      const rec = el.querySelector(".rec");
      rec.addEventListener("click", () => {
        if (recSlot === j) stopRecording();
        else if (recSlot === -1) startRecording(j);
      });
      rec.disabled = recSlot !== -1 && recSlot !== j;
      el.querySelector(".play").addEventListener("click", e => togglePlay([j], e.currentTarget));
      el.querySelector(".clear").addEventListener("click", () => {
        stopAllAudio();
        URL.revokeObjectURL(slots[j].url); slots[j] = null; renderStudio();
      });
      if (recSlot !== -1) el.querySelectorAll(".row button").forEach(b => b.disabled = true);
      grid.appendChild(el);
    });

    const filled = slots.filter(Boolean).length;
    $("playAll").disabled = filled === 0 || recSlot !== -1;
    $("playAll").textContent = "Play all layers";
    $("mixNote").textContent = filled === 0 ? "Record a layer to play the mix"
      : filled + " of 4 layers recorded";
  }

  function showErr(msg) { const e = $("err"); e.textContent = msg; e.style.display = msg ? "block" : "none"; }

